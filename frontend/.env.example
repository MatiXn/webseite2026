# ═══════════════════════════════════════════════════════════════════
# PHE Frontend — Environment Variables
# NUR NEXT_PUBLIC_ Variablen sind im Browser sichtbar!
# Niemals Service-Role-Keys oder Secrets mit NEXT_PUBLIC_ prefixen.
# ═══════════════════════════════════════════════════════════════════

NEXT_PUBLIC_APP_ENV=development

# Supabase — nur Public-Keys ans Frontend
NEXT_PUBLIC_SUPABASE_URL=https://DEIN_PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon_key_nur_public

# Backend API
NEXT_PUBLIC_API_URL=https://api.phe-perm.de

# Sentry (Frontend Error-Tracking)
NEXT_PUBLIC_SENTRY_DSN=https://KEY@oXXXX.ingest.sentry.io/PROJEKT_ID

# ═══════════════════════════════════════════════════════════════════
# Recruiting-Landingpages (/stellen/<slug>)
# ═══════════════════════════════════════════════════════════════════

# Supabase-Projekt für die Bewerber-Leads.
# Bewusst getrennt von NEXT_PUBLIC_SUPABASE_*: Der Service-Role-Key hat volle
# Datenbankrechte und darf niemals denselben Namensraum wie eine öffentliche
# Variable teilen. NIEMALS mit NEXT_PUBLIC_ prefixen.
RECRUITING_SUPABASE_URL=https://DEIN_LEAD_PROJEKT.supabase.co
RECRUITING_SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_NUR_SERVERSEITIG

# Empfänger der Benachrichtigung bei einem neuen Lead.
# Ohne diese Adresse wird der Lead gespeichert, aber niemand informiert.
RECRUITING_NOTIFICATION_EMAIL=bewerbung@phe-perm.de

# Meta-Pixel. Ohne diese ID wird kein Tracking-Skript geladen — die
# Landingpages funktionieren vollständig ohne sie.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API (serverseitige Ereignismeldung, aktuell vorbereitet
# aber nicht angeschlossen — siehe docs/RECRUITING-LANDINGPAGES.md)
META_CONVERSIONS_API_TOKEN=
META_DATASET_ID=

# Salesforce. Standardmäßig aus; die Landingpages laufen ohne Anbindung.
# Auf "true" setzen, sobald die Connected App eingerichtet und die
# Feldzuordnung in src/landingpages/server/salesforce.ts geprüft ist.
SALESFORCE_SYNC_ENABLED=false
SALESFORCE_INSTANCE_URL=https://DEINE_INSTANZ.my.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_API_VERSION=v62.0
